# EmailJS — https://www.emailjs.com/
# 1. Create a Gmail (or other) email service
# 2. Create a template — IMPORTANT field settings:
#    To Email:       dmc4719@gmail.com
#    From Name:      {{from_name}}          (visitor's name in your inbox)
#    From Email:     ✓ Use default address  (MUST stay your Gmail — cannot spoof visitor)
#    Reply To:       {{reply_to}}           (so Reply in Gmail goes to the visitor)
#    Subject:        {{subject}}
#    Body example:
#      New message from {{from_name}} ({{reply_to}})
#      {{message}}
# 3. Enable "Allow non-browser requests" in Account → Security (if using the API route)
# 4. Copy this file to .env.local and fill in your keys

EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
